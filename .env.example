# Gmail address used to send alerts and receive them.
GMAIL_USER=your-gmail-address@gmail.com
# Gmail App Password; do not use your regular Google Account password.
GMAIL_APP_PASSWORD=your-gmail-app-password
# Optional canonical site URL, e.g. https://example.com.
# Vercel deployments fall back to their deployment URL when this is unset.
SITE_URL=
